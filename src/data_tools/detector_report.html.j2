<script>
const tip = document.getElementById("tooltip");
function showTip(x, y, rows) {
  tip.replaceChildren();
  for (const [value, label, series] of rows) {
    const row = document.createElement("div");
    row.className = "row";
    if (series) {
      const key = document.createElement("span");
      key.className = "key-line";
      key.style.background = `var(--${series})`;
      row.appendChild(key);
    }
    const v = document.createElement("span"); v.className = "value"; v.textContent = value;
    const l = document.createElement("span"); l.className = "label"; l.textContent = label;
    row.append(v, l);
    tip.appendChild(row);
  }
  tip.style.display = "block";
  tip.style.left = Math.min(x + 14, window.innerWidth - tip.offsetWidth - 8) + "px";
  tip.style.top = Math.min(y + 14, window.innerHeight - tip.offsetHeight - 8) + "px";
}
for (const node of document.querySelectorAll("[data-tip]")) {
  const rows = JSON.parse(node.dataset.tip);
  node.addEventListener("pointermove", e => showTip(e.clientX, e.clientY, rows));
  node.addEventListener("pointerleave", () => { tip.style.display = "none"; });
  node.addEventListener("focus", () => { const b = node.getBoundingClientRect(); showTip(b.right, b.top, rows); });
  node.addEventListener("blur", () => { tip.style.display = "none"; });
}
const themeButton = document.getElementById("theme");
themeButton.hidden = false;
themeButton.addEventListener("click", () => {
  const root = document.documentElement;
  const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  root.dataset.theme = dark ? "light" : "dark";
});
</script>
</body>
