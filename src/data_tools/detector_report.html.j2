  --series-2: #d95926;
  --series-3: #199e70;
  --mark: #d95926;
}
* { box-sizing: border-box; }
body { margin: 0; }
.viz-root {
  background: var(--page); color: var(--text-primary);
  font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
  min-height: 100vh;
}
main { max-width: 1080px; margin: 0 auto; padding: 32px 24px 64px; }
h1 { font-size: 28px; margin: 0 0 4px; }
h2 { font-size: 20px; margin: 40px 0 8px; padding-top: 8px; }
h3 { font-size: 16px; margin: 24px 0 8px; }
p, li { color: var(--text-primary); }
.lede { color: var(--text-secondary); margin: 0 0 16px; }
.muted { color: var(--text-secondary); }
a { color: var(--series-1); }
nav.toc { display: flex; gap: 16px; flex-wrap: wrap; font-size: 14px; margin: 12px 0 8px; }
nav.toc a { text-decoration: none; }
.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin: 16px 0; }
pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
pre { background: var(--code-bg); border-radius: 8px; padding: 12px 14px; overflow-x: auto; margin: 8px 0 12px; }
code { background: var(--code-bg); border-radius: 4px; padding: 1px 5px; }
pre code { background: none; padding: 0; }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--grid); vertical-align: top; }
th { color: var(--text-secondary); font-weight: 600; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
.tiles { display: grid; grid-template-columns: 1fr; gap: 16px; }
.tile { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(320px, 1.2fr); gap: 20px; align-items: start; }
@media (max-width: 760px) { .tile { grid-template-columns: 1fr; } }
.tile h3 { margin-top: 0; grid-column: 1 / -1; }
.map, .chart { width: 100%; height: auto; display: block; }
.legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; color: var(--text-secondary); margin: 4px 0 6px; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.key-line { width: 16px; height: 2px; border-radius: 1px; display: inline-block; }
.key-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
.key-ring { width: 11px; height: 11px; border-radius: 50%; border: 2px solid var(--mark); display: inline-block; }
.toggle { font: inherit; font-size: 13px; color: var(--text-secondary); background: none; border: 1px solid var(--border);
  border-radius: 6px; padding: 3px 10px; cursor: pointer; }
.toggle:hover { color: var(--text-primary); }
.tooltip { position: fixed; pointer-events: none; background: var(--surface-1); color: var(--text-primary);
  border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-size: 13px; box-shadow: 0 4px 16px rgba(0,0,0,.12);
  display: none; z-index: 10; min-width: 150px; }
.tooltip .value { font-weight: 600; }
.tooltip .row { display: flex; align-items: center; gap: 6px; }
.tooltip .label { color: var(--text-secondary); }
.callout { border-left: 3px solid var(--axis); padding: 4px 12px; color: var(--text-secondary); margin: 12px 0; }
ol.refs li { margin: 0 0 10px; }
ol.refs .why { display: block; color: var(--text-secondary); font-size: 13px; }
.theme-switch { float: right; }
svg text { fill: var(--text-secondary); font-size: 11px; }
.card h3 .file { display: block; font-weight: 400; font-size: 13px; color: var(--text-secondary); }
.card h4 { margin: 18px 0 8px; font-size: 14px; }
.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
.gallery figure { margin: 0; border: 1px solid var(--border); border-radius: 8px; padding: 8px; background: var(--surface-1); }
.gallery figure:focus-visible, .hit:focus-visible { outline: 2px solid var(--series-1); outline-offset: 2px; }
.gallery .zoom { width: 100%; height: auto; display: block; border-radius: 4px; }
.gallery .profile { width: 100%; height: 44px; display: block; margin-top: 6px; }
.gallery figcaption { font-size: 12px; color: var(--text-secondary); margin-top: 4px; font-variant-numeric: tabular-nums; }
.gallery figcaption strong { color: var(--text-primary); }
.gallery-note { margin: 0 0 10px; font-size: 13px; }
details.table-view { margin-top: 12px; }
details.table-view summary { cursor: pointer; color: var(--text-secondary); font-size: 13px; }
details.table-view table { margin-top: 6px; }
svg .ring { fill: none; stroke: var(--mark); stroke-width: 2; }
svg .ring-gap { fill: none; stroke: var(--surface-1); stroke-width: 4; }
svg .ring-label { fill: #ffffff; font-size: 10px; font-weight: 600; paint-order: stroke; stroke: #0b0b0b; stroke-width: 2.5px; }
svg .series { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
svg .series-1 { stroke: var(--series-1); }
svg .series-2 { stroke: var(--series-2); }
svg .series-3 { stroke: var(--series-3); }
svg .dot { fill: var(--series-1); stroke: var(--surface-1); stroke-width: 2; }
svg .grid-line { stroke: var(--grid); stroke-width: 1; }
svg .axis-line { stroke: var(--axis); stroke-width: 1; }
.hit:hover .ring { stroke-width: 3; }
</style>
